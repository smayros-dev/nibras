{
  "$schema": "https://turborepo.dev/schema.json",
  // Strict env mode: a task only sees the env vars listed in its `env` (or `globalEnv`). Every
  // variable read by a test or a build MUST be listed here AND in the CI workflow's `env`
  // (.github/workflows/ci.yml), otherwise it is silently missing (or stale in the cache) in CI.
  // Add new ones to .env.example too.
  "agentGuidance": false,
  "globalEnv": ["NODE_ENV"],
  "globalDependencies": [".env.example"],
  "tasks": {
    "generate": {
      "dependsOn": ["^generate"],
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "^generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["API_URL"]
    },
    // The Prisma client is generated by its own task (not by the build script), so `pnpm build`
    // never runs `prisma generate` twice concurrently.
    "@nibras/db#build": {
      "dependsOn": ["generate", "^build", "^generate"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build", "^generate", "generate"],
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build", "^generate", "generate"]
    },
    "test": {
      "dependsOn": ["^build", "^generate", "generate"],
      "env": [
        "DATABASE_URL",
        "DATABASE_URL_SYSTEM",
        "DATABASE_URL_TEST",
        "DATABASE_URL_TEST_SYSTEM",
        "DATABASE_URL_SHADOW",
        "REDIS_URL",
        "REDIS_URL_TEST",
        // Parallel worktrees: test DB name prefix and Redis index base (@nibras/config/vitest/test-env).
        "TEST_DB_PREFIX",
        "TEST_REDIS_DB_BASE",
        "WEB_ORIGIN",
        "LOG_LEVEL",
        "TRUST_PROXY_HOPS",
        // Deployment tier (development | staging | production), independent of NODE_ENV.
        "APP_ENV",
        // SP1 (auth): listed ahead of time so the first SP1 test does not run without them.
        "JWT_SECRET",
        "TOTP_ENCRYPTION_KEY",
        "EMAIL_FROM",
        "SMTP_URL",
        "SMS_PROVIDER",
        "HIBP_ENABLED",
        "COOKIE_SECURE",
        // SP1 rate limits (env.ts defaults apply when unset; listed so tests see a .env value).
        "RATE_LIMIT_USER",
        "RATE_LIMIT_ANON"
      ]
    },
    // The unused-key guard (src/unused-keys.test.ts) reads the web app's and the UI library's
    // sources: they are inputs too, or a cached pass would hide a key a source change orphaned.
    "@nibras/i18n#test": {
      "dependsOn": ["^build", "^generate", "generate"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/web/src/**",
        "$TURBO_ROOT$/packages/ui/src/**"
      ]
    },
    // Playwright starts the web dev server (`webServer`), which imports the workspace packages'
    // dist: build them first.
    "e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    // The web e2e suite will boot the API and worker once later tasks add them to Playwright
    // `webServer`; they import `@nibras/db`'s dist, and `@nibras/web` itself does not depend on `@nibras/db`,
    // so `^build` alone misses it.
    "@nibras/web#e2e": {
      "dependsOn": ["^build", "@nibras/db#build"],
      "cache": false
    },
    "openapi:export": {
      "dependsOn": ["build"]
    }
  }
}
