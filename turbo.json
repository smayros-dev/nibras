{
  "$schema": "https://turborepo.dev/schema.json",
  "agentGuidance": false,
  "globalEnv": ["NODE_ENV"],
  "globalDependencies": [".env.example"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "DATABASE_URL",
        "DATABASE_URL_SYSTEM",
        "DATABASE_URL_TEST",
        "DATABASE_URL_TEST_SYSTEM",
        "REDIS_URL"
      ]
    },
    "e2e": {
      "cache": false
    },
    "openapi:export": {
      "dependsOn": ["build"]
    }
  }
}
