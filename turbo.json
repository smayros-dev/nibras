{
  "$schema": "https://turborepo.dev/schema.json",
  // Strict env mode: a task only sees the env vars listed in its `env` (or `globalEnv`). Every
  // variable read by a test or a build MUST be listed here AND in the CI workflow's `env`
  // (.github/workflows/ci.yml), otherwise it is silently missing (or stale in the cache) in CI.
  // Add new ones to .env.example too.
  "agentGuidance": false,
  "globalEnv": ["NODE_ENV"],
  "globalDependencies": [".env.example"],
  "tasks": {
    "generate": {
      "dependsOn": ["^generate"],
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "^generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["API_URL"]
    },
    // The Prisma client is generated by its own task (not by the build script), so `pnpm build`
    // never runs `prisma generate` twice concurrently.
    "@nibras/db#build": {
      "dependsOn": ["generate", "^build", "^generate"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build", "^generate", "generate"],
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build", "^generate", "generate"]
    },
    "test": {
      "dependsOn": ["^build", "^generate", "generate"],
      "env": [
        "DATABASE_URL",
        "DATABASE_URL_SYSTEM",
        "DATABASE_URL_TEST",
        "DATABASE_URL_TEST_SYSTEM",
        "DATABASE_URL_SHADOW",
        "REDIS_URL",
        "REDIS_URL_TEST",
        // Parallel worktrees: test DB name prefix and Redis index base (@nibras/config/vitest/test-env).
        "TEST_DB_PREFIX",
        "TEST_REDIS_DB_BASE",
        "WEB_ORIGIN",
        "LOG_LEVEL",
        "TRUST_PROXY_HOPS",
        // Deployment tier (development | staging | production), independent of NODE_ENV.
        "APP_ENV",
        // SP1 (auth): listed ahead of time so the first SP1 test does not run without them.
        "JWT_SECRET",
        "TOTP_ENCRYPTION_KEY",
        "EMAIL_FROM",
        "SMTP_URL",
        "SMS_PROVIDER",
        "HIBP_ENABLED",
        "COOKIE_SECURE",
        // SP1 rate limits (env.ts defaults apply when unset; listed so tests see a .env value).
        "RATE_LIMIT_USER",
        "RATE_LIMIT_ANON",
        // SP3 media: object storage (MinIO locally/CI, OVH in production) and the video provider.
        // S3_BUCKET_TEST is a base: each package derives its own bucket (@nibras/config/vitest/test-env).
        "S3_ENDPOINT",
        "S3_PUBLIC_ENDPOINT",
        "S3_REGION",
        "S3_ACCESS_KEY",
        "S3_SECRET_KEY",
        "S3_BUCKET",
        "S3_BUCKET_TEST",
        "S3_FORCE_PATH_STYLE",
        "VIDEO_PROVIDER",
        // Cloudflare Stream (VIDEO_PROVIDER=cloudflare_stream only; empty/unset in CI and locally).
        "CLOUDFLARE_ACCOUNT_ID",
        "CLOUDFLARE_STREAM_API_TOKEN",
        "CLOUDFLARE_STREAM_WEBHOOK_SECRET",
        "CLOUDFLARE_STREAM_SIGNING_KEY_ID",
        "CLOUDFLARE_STREAM_SIGNING_KEY_PEM",
        "CLOUDFLARE_STREAM_CUSTOMER_SUBDOMAIN"
      ]
    },
    // The unused-key guard (src/unused-keys.test.ts) reads the web app's and the UI library's
    // sources: they are inputs too, or a cached pass would hide a key a source change orphaned.
    "@nibras/i18n#test": {
      "dependsOn": ["^build", "^generate", "generate"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/web/src/**",
        "$TURBO_ROOT$/packages/ui/src/**"
      ]
    },
    // Repo-contract tests (packages/config/infra) read files outside the package: the staging
    // compose file and runbook (SP1.6 T8) and the GitHub workflows (T10).
    "@nibras/config#test": {
      "dependsOn": ["^build", "^generate", "generate"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/infra/compose.staging.yml",
        "$TURBO_ROOT$/docs/runbooks/staging.md",
        "$TURBO_ROOT$/.github/workflows/*.yml"
      ]
    },
    // Playwright starts the web dev server (`webServer`), which imports the workspace packages'
    // dist: build them first.
    "e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    // The web e2e suite will boot the API and worker once later tasks add them to Playwright
    // `webServer`; they import `@nibras/db`'s dist, and `@nibras/web` itself does not depend on `@nibras/db`,
    // so `^build` alone misses it.
    "@nibras/web#e2e": {
      "dependsOn": ["^build", "@nibras/db#build"],
      "cache": false
    },
    "openapi:export": {
      "dependsOn": ["build"]
    }
  }
}
