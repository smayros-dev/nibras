{
  "$schema": "https://turborepo.dev/schema.json",
  "agentGuidance": false,
  "globalEnv": ["NODE_ENV"],
  "globalDependencies": [".env.example"],
  "tasks": {
    "generate": {
      "dependsOn": ["^generate"],
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "^generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build", "^generate", "generate"],
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build", "^generate", "generate"]
    },
    "test": {
      "dependsOn": ["^build", "^generate", "generate"],
      "env": [
        "DATABASE_URL",
        "DATABASE_URL_SYSTEM",
        "DATABASE_URL_TEST",
        "DATABASE_URL_TEST_SYSTEM",
        "DATABASE_URL_SHADOW",
        "REDIS_URL",
        "REDIS_URL_TEST"
      ]
    },
    "e2e": {
      "cache": false
    },
    "openapi:export": {
      "dependsOn": ["build"]
    }
  }
}
