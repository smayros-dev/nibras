{
  "name": "@nibras/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate": "prisma generate",
    "migrate:dev": "dotenv -e ../../.env -- node scripts/migrate-dev.mjs",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "migrate:check": "dotenv -e ../../.env -- node scripts/migrate-check.mjs",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "migrate:test": "dotenv -e ../../.env -- node scripts/migrate-test.mjs",
    "seed": "dotenv -e ../../.env -- node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "prisma": "6.19.3"
  },
  "devDependencies": {
    "@nibras/config": "workspace:*",
    "@nibras/contracts": "workspace:*",
    "@nibras/providers": "workspace:*",
    "@types/node": "^24.19.2",
    "argon2": "0.45.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
