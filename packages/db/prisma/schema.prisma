// Migrations always run as the owner role (app_system).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_SYSTEM")
}

// ─── Enums (PRD §11.1) ──────────────────────────────────────────────────────────

enum WorkspaceType {
  PERSONAL
  ORGANIZATION
}

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
  DELETING
}

enum PlatformRole {
  NONE
  SUPER_ADMIN
}

enum MembershipRole {
  OWNER
  ADMIN
  TEACHER
  ASSISTANT
  STUDENT
  GUARDIAN
}

enum MembershipStatus {
  ACTIVE
  PENDING_APPROVAL
  PENDING_GUARDIAN_CONSENT
  SUSPENDED_NO_CONSENT
  SUSPENDED_CONSENT_REVOKED
  REMOVED
  REJECTED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETING
  DELETED
}

enum AbuseCategory {
  HARASSMENT
  INAPPROPRIATE_CONTENT
  IMPERSONATION
  MINOR_SAFETY
  OTHER
}

enum AbuseReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

/// PRD §11.7 `AbuseReport.entity_type`.
enum AbuseEntityType {
  USER
  MESSAGE
  SESSION
  COURSE
}

enum ConsentType {
  TERMS
  PRIVACY
  CODE_OF_CONDUCT
  GUARDIAN_PARENTAL
  RECORDING
  AI_PROCESSING
  WHATSAPP
  MARKETING
}

enum Locale {
  fr
  ar
  en
}

enum VerificationPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
  EMAIL_CHANGE_OLD
  EMAIL_CHANGE_NEW
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum InviteLinkStatus {
  ACTIVE
  DISABLED
  EXHAUSTED
  EXPIRED
}

/// PRD §11.1 + REFUSED (SP2 D4: a guardian refusal writes no Consent row).
enum GuardianLinkStatus {
  PENDING
  ACTIVE
  REFUSED
  REVOKED
}

/// PRD §8.3.5 « lien de parenté ».
enum GuardianRelationship {
  PARENT
  LEGAL_GUARDIAN
  OTHER
}

enum ImportStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

/// PRD §11.1 (`DELETED` is `Course.deletedAt`, never a stored status).
enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CourseLevel {
  PRIMAIRE
  COLLEGE
  LYCEE
  SUPERIEUR
  ADULTE
  AUTRE
}

/// All seven PRD §11.1 types; SP3 creates VIDEO, PDF and TEXT only (service rule).
enum LessonType {
  VIDEO
  PDF
  TEXT
  LINK
  EMBED
  QUIZ
  ASSIGNMENT
}

enum EnrollmentStatus {
  ACTIVE
  REVOKED
}

enum EnrollmentSource {
  MANUAL
  INVITATION
  INVITE_LINK
}

enum LessonProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum MediaKind {
  VIDEO
  PDF
  IMAGE
  FILE
  RECORDING
}

enum MediaStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
  DELETING
}

enum MediaProvider {
  CLOUDFLARE_STREAM
  MUX
  S3
}

enum MediaFailureReason {
  ABANDONED
  TIMEOUT
  PROVIDER_ERROR
  INVALID_SIGNATURE
  ENCRYPTED
  QUOTA_EXCEEDED
  SIZE_MISMATCH
}

// ─── Identity & tenancy (PRD §11.2) ─────────────────────────────────────────────

model User {
  id                 String       @id @default(uuid(7)) @db.Uuid
  email              String       @unique @db.Citext
  emailVerifiedAt    DateTime?    @map("email_verified_at") @db.Timestamptz
  /// Null when the account only signs in through a social provider (P1).
  passwordHash       String?      @map("password_hash")
  firstName          String       @map("first_name")
  lastName           String       @map("last_name")
  /// → MediaAsset (SP3), SET NULL when the asset is deleted.
  avatarMediaId      String?      @map("avatar_media_id") @db.Uuid
  locale             Locale       @default(fr)
  /// IANA zone.
  timezone           String       @default("Africa/Tunis")
  phoneE164          String?      @map("phone_e164")
  phoneVerifiedAt    DateTime?    @map("phone_verified_at") @db.Timestamptz
  birthDate          DateTime?    @map("birth_date") @db.Date
  platformRole       PlatformRole @default(NONE) @map("platform_role")
  totpSecretEnc      String?      @map("totp_secret_enc")
  totpEnabledAt      DateTime?    @map("totp_enabled_at") @db.Timestamptz
  recoveryCodesHash  String[]     @default([]) @map("recovery_codes_hash")
  status             UserStatus   @default(ACTIVE)
  suspendedReason    String?      @map("suspended_reason")
  suspendedAt        DateTime?    @map("suspended_at") @db.Timestamptz
  deletedAt          DateTime?    @map("deleted_at") @db.Timestamptz
  lastLoginAt        DateTime?    @map("last_login_at") @db.Timestamptz
  /// Last password reset or change (display and audit only: no security decision uses it).
  passwordChangedAt  DateTime?    @map("password_changed_at") @db.Timestamptz
  /// Incremented by every password reset or change; a session issued under another value is dead.
  credentialsVersion Int          @default(0) @map("credentials_version")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  sessions             UserSession[]
  verificationTokens   VerificationToken[]
  phoneOtps            PhoneOtp[]
  ownedWorkspaces      Workspace[]                @relation("WorkspaceOwner")
  memberships          Membership[]
  teacherAssignments   TeacherStudentAssignment[] @relation("AssignmentTeacher")
  studentAssignments   TeacherStudentAssignment[] @relation("AssignmentStudent")
  teacherProfiles      TeacherProfile[]
  consents             Consent[]
  abuseReports         AbuseReport[]
  invitationsSent      Invitation[]
  inviteLinksCreated   InviteLink[]
  studentGuardianLinks GuardianLink[]
  invitationImports    InvitationImport[]
  avatar               MediaAsset?                @relation("UserAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  ownedCourses         Course[]
  ownedMediaAssets     MediaAsset[]               @relation("MediaAssetOwner")
  enrollments          Enrollment[]
  lessonProgress       LessonProgress[]

  // PRD index (email) is the UNIQUE index above.
  @@index([status])
  @@index([avatarMediaId])
  @@map("user")
}

/// Authentication session (one member of a refresh-token family).
model UserSession {
  id                 String    @id @default(uuid(7)) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  refreshTokenHash   String    @unique @map("refresh_token_hash")
  familyId           String    @map("family_id") @db.Uuid
  deviceLabel        String    @map("device_label")
  ip                 String    @db.Inet
  userAgent          String    @map("user_agent")
  /// "Se souvenir de cet appareil": the refresh cookie is persistent (30 d) instead of a session cookie.
  remember           Boolean   @default(false)
  lastSeenAt         DateTime  @map("last_seen_at") @db.Timestamptz
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz
  /// `User.credentialsVersion` read together with the password hash this session was issued on;
  /// any other value than the user's current one means the password changed since: dead session.
  credentialsVersion Int       @default(0) @map("credentials_version")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Hashes this session has rotated away from: presenting one of them is refresh-token reuse.
  rotatedTokens RefreshTokenHistory[]

  @@index([userId])
  @@index([familyId])
  @@map("user_session")
}

/// A refresh-token hash a session has already rotated away from (reuse detection, AC-AUTH-04).
/// Bounded by the session's lifetime (one row per rotation); deleted with the session.
model RefreshTokenHistory {
  tokenHash String   @id @map("token_hash")
  sessionId String   @map("session_id") @db.Uuid
  rotatedAt DateTime @default(now()) @map("rotated_at") @db.Timestamptz

  session UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_token_history")
}

/// Single-use emailed link (verification, password reset, email change). Stores only the token hash.
model VerificationToken {
  id        String              @id @default(uuid(7)) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  purpose   VerificationPurpose
  tokenHash String              @unique @map("token_hash")
  payload   Json?
  expiresAt DateTime            @map("expires_at") @db.Timestamptz
  usedAt    DateTime?           @map("used_at") @db.Timestamptz
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("verification_token")
}

/// SMS one-time code for phone verification (D-O6). Stores only the code hash.
model PhoneOtp {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  phoneE164 String   @map("phone_e164")
  codeHash  String   @map("code_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("phone_otp")
}

model Workspace {
  id                      String          @id @default(uuid(7)) @db.Uuid
  type                    WorkspaceType
  name                    String
  slug                    String          @unique @db.Citext
  status                  WorkspaceStatus @default(ACTIVE)
  suspendedReason         String?         @map("suspended_reason")
  suspendedAt             DateTime?       @map("suspended_at") @db.Timestamptz
  ownerUserId             String          @map("owner_user_id") @db.Uuid
  country                 String?         @db.Char(2)
  defaultTimezone         String          @map("default_timezone")
  defaultLocale           Locale          @map("default_locale")
  /// → MediaAsset (SP3), P1; SET NULL when the asset is deleted.
  logoMediaId             String?         @map("logo_media_id") @db.Uuid
  brandColor              String?         @map("brand_color")
  storageQuotaBytes       BigInt          @map("storage_quota_bytes")
  storageUsedBytes        BigInt          @default(0) @map("storage_used_bytes")
  /// Keys of PRD §8.2.1, validated by a versioned zod schema.
  settings                Json
  aiEnabled               Boolean         @default(false) @map("ai_enabled")
  /// ORGANIZATION only (D-O7).
  allowPersonalWorkspaces Boolean         @default(true) @map("allow_personal_workspaces")
  deletedAt               DateTime?       @map("deleted_at") @db.Timestamptz
  createdAt               DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  owner                     User                       @relation("WorkspaceOwner", fields: [ownerUserId], references: [id])
  memberships               Membership[]
  teacherStudentAssignments TeacherStudentAssignment[]
  teacherProfiles           TeacherProfile[]
  invitations               Invitation[]
  inviteLinks               InviteLink[]
  guardianLinks             GuardianLink[]
  invitationImports         InvitationImport[]
  logo                      MediaAsset?                @relation("WorkspaceLogo", fields: [logoMediaId], references: [id], onDelete: SetNull)
  courses                   Course[]
  modules                   Module[]
  lessons                   Lesson[]
  mediaAssets               MediaAsset[]               @relation("MediaAssetWorkspace")
  enrollments               Enrollment[]
  lessonProgress            LessonProgress[]

  @@index([ownerUserId])
  @@index([status])
  @@index([logoMediaId])
  @@map("workspace")
}

/// 🏢 tenant table.
model Membership {
  id              String           @id @default(uuid(7)) @db.Uuid
  workspaceId     String           @map("workspace_id") @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  role            MembershipRole
  /// ADMIN who also teaches.
  canTeach        Boolean          @default(false) @map("can_teach")
  status          MembershipStatus
  invitedByUserId String?          @map("invited_by_user_id") @db.Uuid
  joinedAt        DateTime?        @map("joined_at") @db.Timestamptz
  removedAt       DateTime?        @map("removed_at") @db.Timestamptz
  removalReason   String?          @map("removal_reason")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@unique([workspaceId, userId])
  @@index([workspaceId, role, status])
  @@index([userId])
  @@map("membership")
}

/// 🏢 Which teacher sees which student. In a PERSONAL workspace a row (owner, student) is created
/// automatically so queries stay uniform.
model TeacherStudentAssignment {
  id               String   @id @default(uuid(7)) @db.Uuid
  workspaceId      String   @map("workspace_id") @db.Uuid
  teacherUserId    String   @map("teacher_user_id") @db.Uuid
  studentUserId    String   @map("student_user_id") @db.Uuid
  assignedByUserId String   @map("assigned_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  teacher   User      @relation("AssignmentTeacher", fields: [teacherUserId], references: [id])
  student   User      @relation("AssignmentStudent", fields: [studentUserId], references: [id])

  @@unique([workspaceId, teacherUserId, studentUserId])
  @@index([workspaceId, studentUserId])
  // FK indexes: the composite keys above lead with workspace_id.
  @@index([teacherUserId])
  @@index([studentUserId])
  @@map("teacher_student_assignment")
}

/// 🏢 tenant table.
model TeacherProfile {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  subjects    String[] @default([])
  bio         String
  externalUrl String?  @map("external_url")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("teacher_profile")
}

/// workspaceId is NULL for TERMS / PRIVACY / CODE_OF_CONDUCT / MARKETING and required for
/// GUARDIAN_PARENTAL, RECORDING, AI_PROCESSING, WHATSAPP. The migration adds the partial unique
/// index (user_id, workspace_id, type) WHERE type = 'GUARDIAN_PARENTAL' AND revoked_at IS NULL.
model Consent {
  id              String      @id @default(uuid(7)) @db.Uuid
  /// The data subject.
  userId          String      @map("user_id") @db.Uuid
  grantedByUserId String?     @map("granted_by_user_id") @db.Uuid
  grantedByEmail  String?     @map("granted_by_email") @db.Citext
  type            ConsentType
  /// e.g. "privacy-2026-10" (CONSENT_VERSIONS in @nibras/contracts).
  version         String
  granted         Boolean
  grantedAt       DateTime    @map("granted_at") @db.Timestamptz
  revokedAt       DateTime?   @map("revoked_at") @db.Timestamptz
  ip              String      @db.Inet
  userAgent       String      @map("user_agent")
  workspaceId     String?     @map("workspace_id") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  user          User           @relation(fields: [userId], references: [id])
  guardianLinks GuardianLink[]

  @@index([userId, type])
  @@index([workspaceId, type])
  @@map("consent")
}

// ─── Students & invitations (PRD §11.2, SP2) ────────────────────────────────────

/// 🏢 Email invitation (student or staff, SP2 D1). Only the SHA-256 of the link token is stored.
/// The migration adds the partial unique index (workspace_id, email) WHERE status = 'PENDING'.
model Invitation {
  id               String           @id @default(uuid(7)) @db.Uuid
  workspaceId      String           @map("workspace_id") @db.Uuid
  email            String           @db.Citext
  /// STUDENT, TEACHER or ADMIN only (service rule).
  role             MembershipRole
  firstName        String?          @map("first_name")
  lastName         String?          @map("last_name")
  guardianEmail    String?          @map("guardian_email") @db.Citext
  birthDate        DateTime?        @map("birth_date") @db.Date
  tokenHash        String           @unique @map("token_hash")
  expiresAt        DateTime         @map("expires_at") @db.Timestamptz
  /// A stored PENDING past `expiresAt` is served as EXPIRED; the daily job flips it.
  status           InvitationStatus
  invitedByUserId  String           @map("invited_by_user_id") @db.Uuid
  /// ≤ 500 characters (service rule).
  message          String?
  /// → Course (SP3); no FK until that table exists.
  courseIds        String[]         @default([]) @map("course_ids") @db.Uuid
  /// ORGANIZATION: the teacher the student is assigned to at acceptance.
  teacherUserId    String?          @map("teacher_user_id") @db.Uuid
  acceptedByUserId String?          @map("accepted_by_user_id") @db.Uuid
  acceptedAt       DateTime?        @map("accepted_at") @db.Timestamptz
  revokedAt        DateTime?        @map("revoked_at") @db.Timestamptz
  resentCount      Int              @default(0) @map("resent_count")
  lastSentAt       DateTime         @map("last_sent_at") @db.Timestamptz
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation(fields: [invitedByUserId], references: [id])

  @@index([workspaceId, status])
  @@index([workspaceId, email])
  @@index([invitedByUserId])
  @@map("invitation")
}

/// 🏢 Group link / code (PRD §8.3.2). Codes are not bound to an address (D-P18).
model InviteLink {
  id               String           @id @default(uuid(7)) @db.Uuid
  workspaceId      String           @map("workspace_id") @db.Uuid
  /// 8 characters from INVITE_CODE_ALPHABET (@nibras/contracts), stored upper-case.
  code             String           @unique
  /// ≤ 80 characters (service rule).
  label            String?
  /// Kept for §11.2 parity; the service forces STUDENT.
  role             MembershipRole
  createdByUserId  String           @map("created_by_user_id") @db.Uuid
  teacherUserId    String?          @map("teacher_user_id") @db.Uuid
  /// → Course (SP3); no FK until that table exists.
  courseIds        String[]         @default([]) @map("course_ids") @db.Uuid
  requiresApproval Boolean          @map("requires_approval")
  maxUses          Int              @map("max_uses")
  usesCount        Int              @default(0) @map("uses_count")
  /// Past this instant the link is served as EXPIRED.
  expiresAt        DateTime?        @map("expires_at") @db.Timestamptz
  status           InviteLinkStatus
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdByUserId], references: [id])

  @@index([workspaceId, status])
  // FK index: the composite key above leads with workspace_id.
  @@index([createdByUserId])
  @@map("invite_link")
}

/// 🏢 One per (student, workspace) (D-O5): the guardian's consent request and long-lived page.
/// Only SHA-256 hashes of the two link tokens are stored.
model GuardianLink {
  id                    String                @id @default(uuid(7)) @db.Uuid
  workspaceId           String                @map("workspace_id") @db.Uuid
  studentUserId         String                @map("student_user_id") @db.Uuid
  /// Null until the guardian account exists (P1); no FK until then.
  guardianUserId        String?               @map("guardian_user_id") @db.Uuid
  guardianEmail         String                @map("guardian_email") @db.Citext
  guardianFirstName     String?               @map("guardian_first_name")
  guardianLastName      String?               @map("guardian_last_name")
  relationship          GuardianRelationship?
  status                GuardianLinkStatus
  /// The GUARDIAN_PARENTAL consent this link granted (null while pending, refused or revoked).
  consentId             String?               @map("consent_id") @db.Uuid
  /// The 14-day consent request link.
  consentTokenHash      String?               @unique @map("consent_token_hash")
  consentExpiresAt      DateTime?             @map("consent_expires_at") @db.Timestamptz
  consentSentAt         DateTime?             @map("consent_sent_at") @db.Timestamptz
  consentResentCount    Int                   @default(0) @map("consent_resent_count")
  /// The long-lived guardian page link (§11.2 name), replaced at every re-grant.
  sessionsViewTokenHash String?               @unique @map("sessions_view_token_hash")
  decidedAt             DateTime?             @map("decided_at") @db.Timestamptz
  revokedAt             DateTime?             @map("revoked_at") @db.Timestamptz
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  student   User      @relation(fields: [studentUserId], references: [id])
  consent   Consent?  @relation(fields: [consentId], references: [id])

  @@unique([studentUserId, workspaceId])
  @@index([workspaceId, studentUserId])
  @@index([guardianUserId])
  @@index([guardianEmail])
  @@index([consentId])
  @@map("guardian_link")
}

/// 🏢 CSV import (PRD §8.3.4); rows are created and emailed by the worker (SP2 D10).
model InvitationImport {
  id              String       @id @default(uuid(7)) @db.Uuid
  workspaceId     String       @map("workspace_id") @db.Uuid
  createdByUserId String       @map("created_by_user_id") @db.Uuid
  /// ≤ 255 characters (service rule).
  fileName        String       @map("file_name")
  status          ImportStatus
  /// Parsed valid rows the worker consumes: [{ line, email, firstName?, lastName?, guardianEmail?, birthDate?, courseCodes }].
  rows            Json
  /// Per-line outcome, filled progressively: [{ line, email, outcome, message? }].
  report          Json
  totalRows       Int          @map("total_rows")
  validRows       Int          @map("valid_rows")
  processedRows   Int          @default(0) @map("processed_rows")
  createdCount    Int          @default(0) @map("created_count")
  failedCount     Int          @default(0) @map("failed_count")
  error           String?
  startedAt       DateTime?    @map("started_at") @db.Timestamptz
  finishedAt      DateTime?    @map("finished_at") @db.Timestamptz
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdByUserId], references: [id])

  @@index([workspaceId, createdAt(sort: Desc)])
  // FK index: the composite key above leads with workspace_id.
  @@index([createdByUserId])
  @@map("invitation_import")
}

// ─── Courses, content & media (PRD §11.3, §11.6, SP3) ───────────────────────────

/// 🏢 A course (PRD §11.3). Soft-deleted through `deletedAt` (purged after 30 days); `version` is
/// bumped by every mutation of the course, its modules and its lessons (D-P14 `If-Match`).
model Course {
  id                String       @id @default(uuid(7)) @db.Uuid
  workspaceId       String       @map("workspace_id") @db.Uuid
  ownerUserId       String       @map("owner_user_id") @db.Uuid
  /// ≤ 200 characters (service rule).
  title             String
  /// Rich text (ProseMirror JSON, `RichTextDocSchema`).
  description       Json?
  coverMediaId      String?      @map("cover_media_id") @db.Uuid
  /// ≤ 60 characters (service rule).
  category          String?
  level             CourseLevel?
  language          Locale
  /// Override; NULL = derived from the lessons.
  estimatedMinutes  Int?         @map("estimated_minutes")
  sequentialLessons Boolean      @default(false) @map("sequential_lessons")
  isCertifying      Boolean      @default(false) @map("is_certifying")
  status            CourseStatus @default(DRAFT)
  publishedAt       DateTime?    @map("published_at") @db.Timestamptz
  archivedAt        DateTime?    @map("archived_at") @db.Timestamptz
  deletedAt         DateTime?    @map("deleted_at") @db.Timestamptz
  version           Int          @default(1)
  /// Duplicated from (P1); no FK.
  sourceCourseId    String?      @map("source_course_id") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner       User         @relation(fields: [ownerUserId], references: [id])
  cover       MediaAsset?  @relation("CourseCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  modules     Module[]
  enrollments Enrollment[]

  @@index([workspaceId, ownerUserId, status])
  @@index([workspaceId, status])
  @@index([deletedAt])
  // FK indexes: the composite keys above lead with workspace_id.
  @@index([ownerUserId])
  @@index([coverMediaId])
  @@map("course")
}

/// 🏢 A module of a course. Positions are 1..n per course; the migration re-creates the unique
/// constraint DEFERRABLE INITIALLY IMMEDIATE (spec D9: reorder under SET CONSTRAINTS … DEFERRED).
model Module {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  courseId    String   @map("course_id") @db.Uuid
  /// ≤ 200 characters (service rule).
  title       String
  description String?
  position    Int
  isOptional  Boolean  @default(false) @map("is_optional")
  /// `{ type: 'NONE' }` | `{ type: 'PREVIOUS_MODULE_COMPLETED' }` at MVP (`UnlockRuleSchema`).
  unlockRule  Json     @default("{\"type\":\"NONE\"}") @map("unlock_rule")
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   Lesson[]

  @@unique([courseId, position], map: "module_course_position_key")
  @@index([courseId])
  @@map("module")
}

/// 🏢 A lesson of a module. The migration adds `lesson_content_by_type_check` (VIDEO/PDF → media,
/// TEXT → content) and re-creates the position constraint DEFERRABLE (spec D9).
model Lesson {
  id               String     @id @default(uuid(7)) @db.Uuid
  workspaceId      String     @map("workspace_id") @db.Uuid
  moduleId         String     @map("module_id") @db.Uuid
  /// ≤ 200 characters (service rule).
  title            String
  description      String?
  type             LessonType
  position         Int
  isRequired       Boolean    @default(true) @map("is_required")
  estimatedMinutes Int?       @map("estimated_minutes")
  isPreview        Boolean    @default(false) @map("is_preview")
  mediaAssetId     String?    @map("media_asset_id") @db.Uuid
  allowDownload    Boolean    @default(false) @map("allow_download")
  /// TEXT: rich text (ProseMirror JSON, `RichTextDocSchema`).
  content          Json?
  /// LINK / EMBED / QUIZ / ASSIGNMENT columns are P1: never written by SP3.
  externalUrl      String?    @map("external_url")
  embedUrl         String?    @map("embed_url")
  quizId           String?    @map("quiz_id") @db.Uuid
  assignmentId     String?    @map("assignment_id") @db.Uuid
  version          Int        @default(1)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  workspace  Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  module     Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  /// NO ACTION (checked at the end of the statement): an asset in use cannot be deleted on its own,
  /// yet a workspace deletion that cascades to both the lesson and the asset goes through.
  mediaAsset MediaAsset?      @relation(fields: [mediaAssetId], references: [id], onDelete: NoAction)
  progress   LessonProgress[]

  @@unique([moduleId, position], map: "lesson_module_position_key")
  @@index([moduleId])
  @@index([mediaAssetId])
  @@map("lesson")
}

/// 🏢 An uploaded or provider-hosted file (PRD §11.6). The migration adds the partial unique index
/// (provider, provider_asset_id) WHERE provider_asset_id IS NOT NULL.
model MediaAsset {
  id                  String              @id @default(uuid(7)) @db.Uuid
  workspaceId         String              @map("workspace_id") @db.Uuid
  ownerUserId         String              @map("owner_user_id") @db.Uuid
  kind                MediaKind
  provider            MediaProvider
  /// Stream uid (Cloudflare).
  providerAssetId     String?             @map("provider_asset_id")
  /// Object key (S3).
  storageKey          String?             @map("storage_key")
  /// S3 multipart upload id, cleared at complete.
  uploadId            String?             @map("upload_id")
  status              MediaStatus
  failureReason       MediaFailureReason? @map("failure_reason")
  /// ≤ 255 characters (service rule).
  originalFilename    String              @map("original_filename")
  mimeType            String              @map("mime_type")
  /// Declared at upload, then the actual size.
  sizeBytes           BigInt              @map("size_bytes")
  checksumSha256      String?             @map("checksum_sha256")
  durationS           Int?                @map("duration_s")
  width               Int?
  height              Int?
  thumbnailUrl        String?             @map("thumbnail_url")
  pageCount           Int?                @map("page_count")
  uploadUrlExpiresAt  DateTime?           @map("upload_url_expires_at") @db.Timestamptz
  processingStartedAt DateTime?           @map("processing_started_at") @db.Timestamptz
  readyAt             DateTime?           @map("ready_at") @db.Timestamptz
  deletedAt           DateTime?           @map("deleted_at") @db.Timestamptz
  /// What was added to Workspace.storageUsedBytes (spec D17), so the decrement is exact.
  countedBytes        BigInt              @default(0) @map("counted_bytes")
  /// RECORDING (V2-c); no FK until the session table exists.
  sessionId           String?             @map("session_id") @db.Uuid
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  workspace        Workspace   @relation("MediaAssetWorkspace", fields: [workspaceId], references: [id], onDelete: Cascade)
  owner            User        @relation("MediaAssetOwner", fields: [ownerUserId], references: [id])
  lessons          Lesson[]
  coverOfCourses   Course[]    @relation("CourseCover")
  avatarOfUsers    User[]      @relation("UserAvatar")
  logoOfWorkspaces Workspace[] @relation("WorkspaceLogo")

  @@index([workspaceId, status])
  @@index([ownerUserId])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("media_asset")
}

/// 🏢 A student's access to a course (PRD §8.5.1). The migration adds
/// `enrollment_progress_percent_check` (0–100).
model Enrollment {
  id               String           @id @default(uuid(7)) @db.Uuid
  workspaceId      String           @map("workspace_id") @db.Uuid
  courseId         String           @map("course_id") @db.Uuid
  studentUserId    String           @map("student_user_id") @db.Uuid
  status           EnrollmentStatus
  /// No FK (same as TeacherStudentAssignment.assignedByUserId).
  assignedByUserId String           @map("assigned_by_user_id") @db.Uuid
  source           EnrollmentSource
  activatedAt      DateTime         @map("activated_at") @db.Timestamptz
  revokedAt        DateTime?        @map("revoked_at") @db.Timestamptz
  revokedReason    String?          @map("revoked_reason")
  progressPercent  Int              @default(0) @map("progress_percent") @db.SmallInt
  completedAt      DateTime?        @map("completed_at") @db.Timestamptz
  lastActivityAt   DateTime?        @map("last_activity_at") @db.Timestamptz
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student   User      @relation(fields: [studentUserId], references: [id])

  @@unique([courseId, studentUserId])
  @@index([workspaceId, studentUserId])
  @@index([courseId, status])
  // FK index, and the cross-tenant `/me` lookup by studentUserId (spec D7).
  @@index([studentUserId])
  @@map("enrollment")
}

/// 🏢 Per-lesson progress, full PRD §11.3 shape (spec D6: SP4 adds segments and auto-completion
/// without a migration).
model LessonProgress {
  id                String               @id @default(uuid(7)) @db.Uuid
  workspaceId       String               @map("workspace_id") @db.Uuid
  lessonId          String               @map("lesson_id") @db.Uuid
  studentUserId     String               @map("student_user_id") @db.Uuid
  status            LessonProgressStatus @default(NOT_STARTED)
  lastPositionS     Int                  @default(0) @map("last_position_s")
  watchedSegments   Json                 @default("[]") @map("watched_segments")
  uniqueWatchedS    Int                  @default(0) @map("unique_watched_s")
  openedAt          DateTime?            @map("opened_at") @db.Timestamptz
  completedAt       DateTime?            @map("completed_at") @db.Timestamptz
  completedManually Boolean              @default(false) @map("completed_manually")
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lesson    Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student   User      @relation(fields: [studentUserId], references: [id])

  @@unique([lessonId, studentUserId])
  @@index([workspaceId, studentUserId])
  @@index([studentUserId, status])
  @@map("lesson_progress")
}

/// Provider webhook receipt (not a tenant table). Idempotence by (provider, providerEventId);
/// Cloudflare Stream's event id is sha256(raw body) (spec D11).
model WebhookEvent {
  id              String    @id @default(uuid(7)) @db.Uuid
  /// 'cloudflare_stream' | …
  provider        String
  providerEventId String    @map("provider_event_id")
  payload         Json
  signatureValid  Boolean   @map("signature_valid")
  receivedAt      DateTime  @default(now()) @map("received_at") @db.Timestamptz
  processedAt     DateTime? @map("processed_at") @db.Timestamptz
  error           String?

  @@unique([provider, providerEventId])
  @@index([receivedAt])
  @@map("webhook_event")
}

// ─── Compliance & platform (PRD §11.7) ──────────────────────────────────────────

/// Append-only: no updatedAt and no foreign keys (entries outlive the rows they describe).
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  workspaceId String?  @map("workspace_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorRole   String   @map("actor_role")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id") @db.Uuid
  before      Json?
  after       Json?
  ip          String?  @db.Inet
  userAgent   String?  @map("user_agent")
  requestId   String   @map("request_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@map("audit_log")
}

/// MINOR_SAFETY reports are always visible to the super-admin.
model AbuseReport {
  id               String            @id @default(uuid(7)) @db.Uuid
  /// NULL when reported outside a workspace (e.g. a profile).
  workspaceId      String?           @map("workspace_id") @db.Uuid
  reporterUserId   String            @map("reporter_user_id") @db.Uuid
  category         AbuseCategory
  description      String
  entityType       AbuseEntityType   @map("entity_type")
  entityId         String            @map("entity_id") @db.Uuid
  /// Frozen copy of the entity at report time.
  contextSnapshot  Json              @map("context_snapshot")
  attachments      String[]          @default([]) @db.Uuid
  status           AbuseReportStatus
  assignedToUserId String?           @map("assigned_to_user_id") @db.Uuid
  resolution       String?
  resolvedAt       DateTime?         @map("resolved_at") @db.Timestamptz
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  reporter User @relation(fields: [reporterUserId], references: [id])

  @@index([workspaceId, status, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([reporterUserId])
  @@map("abuse_report")
}
