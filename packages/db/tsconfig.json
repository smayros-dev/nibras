{
  "extends": "@nibras/config/tsconfig/package",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    // `prisma/seed.ts` runs under Node type stripping, which needs the `.ts` extension.
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/**/*.ts", "prisma/seed.ts", "vitest.config.ts", "vitest.setup.ts"]
}
