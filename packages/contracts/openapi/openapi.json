{
  "components": {
    "schemas": {
      "LoginDto": {
        "properties": {
          "email": {
            "format": "email",
            "maxLength": 254,
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
            "type": "string"
          },
          "password": {
            "maxLength": 256,
            "type": "string"
          },
          "remember": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "type": "object"
      },
      "RegisterTeacherDto": {
        "properties": {
          "acceptPrivacy": {
            "enum": [
              true
            ],
            "type": "boolean"
          },
          "acceptTerms": {
            "enum": [
              true
            ],
            "type": "boolean"
          },
          "email": {
            "format": "email",
            "maxLength": 254,
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
            "type": "string"
          },
          "firstName": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "kind": {
            "enum": [
              "TEACHER"
            ],
            "type": "string"
          },
          "lastName": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "locale": {
            "enum": [
              "fr",
              "ar",
              "en"
            ],
            "type": "string"
          },
          "password": {
            "maxLength": 256,
            "type": "string"
          },
          "timezone": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "firstName",
          "lastName",
          "email",
          "password",
          "locale",
          "timezone",
          "acceptTerms",
          "acceptPrivacy"
        ],
        "type": "object"
      },
      "VerifyEmailDto": {
        "properties": {
          "token": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "type": "object"
      }
    }
  },
