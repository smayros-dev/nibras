{
  "components": {
    "schemas": {
      "ChangePasswordDto": {
        "properties": {
          "currentPassword": {
            "maxLength": 256,
            "type": "string"
          },
          "newPassword": {
            "maxLength": 256,
            "type": "string"
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ],
        "type": "object"
      },
      "EmailChangeConfirmDto": {
        "properties": {
          "token": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "type": "object"
      },
      "EmailChangeRequestDto": {
        "properties": {
          "newEmail": {
            "format": "email",
            "maxLength": 254,
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
            "type": "string"
          },
          "password": {
            "maxLength": 256,
            "type": "string"
          }
        },
        "required": [
          "newEmail",
          "password"
        ],
        "type": "object"
      },
      "ForgotPasswordDto": {
        "properties": {
          "email": {
            "format": "email",
            "maxLength": 254,
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "type": "object"
      },
      "GrantConsentDto": {
        "properties": {
          "version": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "version"
        ],
        "type": "object"
      },
      "LoginDto": {
        "properties": {
          "email": {
            "format": "email",
            "maxLength": 254,
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
            "type": "string"
          },
          "password": {
            "maxLength": 256,
            "type": "string"
          },
          "remember": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "type": "object"
      },
      "PhoneOtpRequestDto": {
        "properties": {
          "phoneE164": {
            "pattern": "^\\+[1-9]\\d{1,14}$",
            "type": "string"
          }
        },
        "required": [
          "phoneE164"
        ],
        "type": "object"
      },
      "PhoneOtpVerifyDto": {
        "properties": {
          "otpCode": {
            "pattern": "^\\d{6}$",
            "type": "string"
          }
        },
        "required": [
          "otpCode"
        ],
        "type": "object"
      },
      "RegisterTeacherDto": {
        "properties": {
          "acceptPrivacy": {
            "enum": [
              true
            ],
            "type": "boolean"
          },
          "acceptTerms": {
            "enum": [
              true
            ],
            "type": "boolean"
          },
          "email": {
            "format": "email",
            "maxLength": 254,
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
            "type": "string"
          },
          "firstName": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "kind": {
            "enum": [
              "TEACHER"
            ],
            "type": "string"
          },
          "lastName": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "locale": {
            "enum": [
              "fr",
              "ar",
              "en"
            ],
            "type": "string"
          },
          "password": {
            "maxLength": 256,
            "type": "string"
          },
          "timezone": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "firstName",
          "lastName",
          "email",
          "password",
          "locale",
          "timezone",
          "acceptTerms",
          "acceptPrivacy"
        ],
        "type": "object"
      },
      "ResetPasswordDto": {
        "properties": {
          "newPassword": {
            "maxLength": 256,
            "type": "string"
          },
          "token": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "token",
          "newPassword"
        ],
        "type": "object"
      },
      "TwoFactorDisableDto": {
        "properties": {
          "otpCode": {
            "pattern": "^\\d{6}$",
            "type": "string"
          }
        },
        "required": [
          "otpCode"
        ],
        "type": "object"
      },
      "TwoFactorRecoveryDto": {
        "properties": {
          "challengeToken": {
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
          },
          "recoveryCode": {
            "maxLength": 32,
            "minLength": 1,
            "type": "string"
          },
          "remember": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "challengeToken",
          "recoveryCode"
        ],
        "type": "object"
      },
      "TwoFactorVerifyDto": {
        "properties": {
          "challengeToken": {
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
          },
          "otpCode": {
            "pattern": "^\\d{6}$",
            "type": "string"
          },
          "remember": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "otpCode"
        ],
        "type": "object"
      },
      "UpdateMeDto": {
        "additionalProperties": false,
        "properties": {
          "birthDate": {
            "type": "string"
          },
          "firstName": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "lastName": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "locale": {
            "enum": [
              "fr",
              "ar",
              "en"
            ],
            "type": "string"
          },
          "timezone": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "VerifyEmailDto": {
        "properties": {
          "token": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "type": "object"
      }
    }
  },
