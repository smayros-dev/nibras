{
  "components": {
    "schemas": {
      "ChangePasswordDto": {
        "properties": {
          "currentPassword": {
            "maxLength": 256,
            "type": "string"
          },
          "newPassword": {
            "maxLength": 256,
            "type": "string"
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ],
        "type": "object"
      },
      "CreateOrganizationDto": {
        "additionalProperties": false,
        "properties": {
          "country": {
            "pattern": "^[A-Za-z]{2}$",
            "type": "string"
          },
          "name": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "timezone": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "timezone"
        ],
        "type": "object"
      },
      "EmailChangeConfirmDto": {
        "properties": {
          "token": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "type": "object"
      },
      "EmailChangeRequestDto": {
        "properties": {
          "newEmail": {
            "format": "email",
            "maxLength": 254,
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
            "type": "string"
          },
          "password": {
            "maxLength": 256,
            "type": "string"
          }
        },
        "required": [
          "newEmail",
          "password"
        ],
        "type": "object"
      },
      "ForgotPasswordDto": {
        "properties": {
          "email": {
            "format": "email",
            "maxLength": 254,
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "type": "object"
      },
      "GrantConsentDto": {
        "properties": {
          "version": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "version"
        ],
        "type": "object"
      },
      "LoginDto": {
        "properties": {
          "email": {
            "format": "email",
            "maxLength": 254,
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
            "type": "string"
          },
          "password": {
            "maxLength": 256,
            "type": "string"
          },
          "remember": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "type": "object"
      },
      "PhoneOtpRequestDto": {
        "properties": {
          "phoneE164": {
            "pattern": "^\\+[1-9]\\d{1,14}$",
            "type": "string"
          }
        },
        "required": [
          "phoneE164"
        ],
        "type": "object"
      },
      "PhoneOtpVerifyDto": {
        "properties": {
          "otpCode": {
            "pattern": "^\\d{6}$",
            "type": "string"
          }
        },
        "required": [
          "otpCode"
        ],
        "type": "object"
      },
      "RegisterTeacherDto": {
        "properties": {
          "acceptPrivacy": {
            "enum": [
              true
            ],
            "type": "boolean"
          },
          "acceptTerms": {
            "enum": [
              true
            ],
            "type": "boolean"
          },
          "email": {
            "format": "email",
            "maxLength": 254,
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
            "type": "string"
          },
          "firstName": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "kind": {
            "enum": [
              "TEACHER"
            ],
            "type": "string"
          },
          "lastName": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "locale": {
            "enum": [
              "fr",
              "ar",
              "en"
            ],
            "type": "string"
          },
          "password": {
            "maxLength": 256,
            "type": "string"
          },
          "timezone": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "firstName",
          "lastName",
          "email",
          "password",
          "locale",
          "timezone",
          "acceptTerms",
          "acceptPrivacy"
        ],
        "type": "object"
      },
      "ResetPasswordDto": {
        "properties": {
          "newPassword": {
            "maxLength": 256,
            "type": "string"
          },
          "token": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "token",
          "newPassword"
        ],
        "type": "object"
      },
      "TransferOwnershipDto": {
        "additionalProperties": false,
        "properties": {
          "toUserId": {
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "type": "string"
          }
        },
        "required": [
          "toUserId"
        ],
        "type": "object"
      },
      "TwoFactorDisableDto": {
        "properties": {
          "otpCode": {
            "pattern": "^\\d{6}$",
            "type": "string"
          }
        },
        "required": [
          "otpCode"
        ],
        "type": "object"
      },
      "TwoFactorRecoveryDto": {
        "properties": {
          "challengeToken": {
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
          },
          "recoveryCode": {
            "maxLength": 32,
            "minLength": 1,
            "type": "string"
          },
          "remember": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "challengeToken",
          "recoveryCode"
        ],
        "type": "object"
      },
      "TwoFactorVerifyDto": {
        "properties": {
          "challengeToken": {
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
          },
          "otpCode": {
            "pattern": "^\\d{6}$",
            "type": "string"
          },
          "remember": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "otpCode"
        ],
        "type": "object"
      },
      "UpdateMeDto": {
        "additionalProperties": false,
        "properties": {
          "birthDate": {
            "type": "string"
          },
          "firstName": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "lastName": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "locale": {
            "enum": [
              "fr",
              "ar",
              "en"
            ],
            "type": "string"
          },
          "timezone": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "UpdateWorkspaceDto": {
        "additionalProperties": false,
        "properties": {
          "allowPersonalWorkspaces": {
            "type": "boolean"
          },
          "country": {
            "nullable": true,
            "pattern": "^[A-Za-z]{2}$",
            "type": "string"
          },
          "defaultLocale": {
            "enum": [
              "fr",
              "ar",
              "en"
            ],
            "type": "string"
          },
          "defaultTimezone": {
            "type": "string"
          },
          "name": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          }
        },
        "type": "object"
      },
      "VerifyEmailDto": {
        "properties": {
          "token": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "type": "object"
      },
      "WorkspaceSettingsPatchDto": {
        "additionalProperties": false,
        "properties": {
          "default_pdf_download": {
            "type": "boolean"
          },
          "default_reminder_offsets_min": {
            "items": {
              "maximum": 10080,
              "minimum": 0,
              "type": "integer"
            },
            "maxItems": 5,
            "type": "array"
          },
          "default_sequential_lessons": {
            "type": "boolean"
          },
          "default_timezone": {
            "type": "string"
          },
          "empty_room_grace_min": {
            "maximum": 30,
            "minimum": 1,
            "type": "integer"
          },
          "late_threshold_min": {
            "maximum": 60,
            "minimum": 0,
            "type": "integer"
          },
          "partial_ratio": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "present_ratio": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "student_join_window_min": {
            "maximum": 60,
            "minimum": 0,
            "type": "integer"
          },
          "teacher_join_window_min": {
            "maximum": 60,
            "minimum": 0,
            "type": "integer"
          }
        },
        "type": "object"
      }
    }
  },
