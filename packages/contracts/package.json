{
  "name": "@nibras/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./web": {
      "import": {
        "types": "./dist/web.d.ts",
        "default": "./dist/web.js"
      },
      "require": {
        "types": "./dist/web.d.cts",
        "default": "./dist/web.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/web.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts src/web.ts --format esm,cjs --dts --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate": "openapi-typescript ./openapi/openapi.json -o ./src/generated/api.d.ts"
  },
  "dependencies": {
    "libphonenumber-js": "^1.13.15",
    "openapi-fetch": "^0.17.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nibras/config": "workspace:*",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "openapi-typescript": "^7.13.0",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
