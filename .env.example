# Copy to `.env` (gitignored) for local development. Never commit real secrets.

# Database: the API connects as app_user (RLS enforced); migrations/worker/test resets use app_system (BYPASSRLS).
DATABASE_URL=postgresql://app_user:app@localhost:5432/nibras
DATABASE_URL_SYSTEM=postgresql://app_system:app@localhost:5432/nibras
# Test DBs: a base URL. Each package swaps the database name for its own (nibras_db_test, nibras_api_test,
# nibras_worker_test; see packages/config/vitest/test-env.mjs) so turbo can run their tests in parallel.
# Create/migrate them with `pnpm db:migrate:test`.
DATABASE_URL_TEST=postgresql://app_user:app@localhost:5432/nibras_test
DATABASE_URL_TEST_SYSTEM=postgresql://app_system:app@localhost:5432/nibras_test
# Parallel git worktrees only (leave unset in the main checkout): the test DB name prefix
# (`<prefix>_<pkg>_test`, default nibras) and the Redis index base (an integer 1..13, default 13; the
# packages use base, base+1, base+2). Run `pnpm db:migrate:test` in the worktree after setting them.
# TEST_DB_PREFIX=nibras_t1
# TEST_REDIS_DB_BASE=10
# Prisma shadow DB for `migrate:check`; wiped on every run, never point it at nibras or a test DB.
DATABASE_URL_SHADOW=postgresql://app_system:app@localhost:5432/nibras_shadow

REDIS_URL=redis://localhost:6379
# Redis for tests (worker queue specs wipe their queues): a base URL; each package replaces the DB
# index with its own (13 db, 14 api, 15 worker, shifted by TEST_REDIS_DB_BASE), never 0 (the dev DB).
REDIS_URL_TEST=redis://localhost:6379/15

NODE_ENV=development
# Deployment tier: development | staging | production (independent of NODE_ENV, which is
# `production` in every built image). Production-only guards key off this one.
APP_ENV=development
# The API's port, for local dev only. Staging ignores it: compose.staging.yml pins each service's port.
PORT=3001
WORKER_PORT=3002
WEB_ORIGIN=http://localhost:3000
API_URL=http://localhost:3001
LOG_LEVEL=debug
# Proxy hops in front of the API whose X-Forwarded-For entries are trusted (req.ip = client).
# 1 locally (the Next.js server); see docs/runbooks/staging.md for staging.
TRUST_PROXY_HOPS=1
# Empty = tracing off.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Email: Mailpit locally (UI http://localhost:8025).
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="Nibras (dev) <no-reply@nibras.localhost>"

# Auth (SP1). Dev-only placeholder values: generate real ones per environment
# (`openssl rand -base64 48` for JWT_SECRET, `openssl rand -base64 32` for the 32-byte TOTP key).
# Staging/production (APP_ENV=staging|production) refuse these values at startup, like the CI and
# test values, any `dev-only`/`ci-only`/`test-only`/`change-me` value, a JWT_SECRET with fewer than
# 3 character classes, the DB password `app` above, COOKIE_SECURE=false and an http: WEB_ORIGIN
# (API and worker; see docs/runbooks/staging.md). APP_ENV=development (or unset) accepts them.
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
TOTP_ENCRYPTION_KEY=ZGV2LW9ubHktdG90cC1rZXktMzItYnl0ZXMtbG9uZyE=
# SMS provider for OTPs: `console` logs the message instead of sending it (dev/test).
SMS_PROVIDER=console
# Have I Been Pwned password check (network call): off locally and in tests.
HIBP_ENABLED=false
# Secure cookies need HTTPS: false on http://localhost, true on staging/production.
COOKIE_SECURE=false
# Global API rate limits (per minute): anonymous per-IP, authenticated per-user. The login
# throttle and the phone-OTP limiter are separate (see docs/runbooks/auth-and-tenancy.md).
RATE_LIMIT_ANON=60
RATE_LIMIT_USER=600

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=nibras-dev
