# Copy to `.env` (gitignored) for local development. Never commit real secrets.

# Database: the API connects as app_user (RLS enforced); migrations/worker/test resets use app_system (BYPASSRLS).
DATABASE_URL=postgresql://app_user:app@localhost:5432/tt
DATABASE_URL_SYSTEM=postgresql://app_system:app@localhost:5432/tt
DATABASE_URL_TEST=postgresql://app_user:app@localhost:5432/tt_test
DATABASE_URL_TEST_SYSTEM=postgresql://app_system:app@localhost:5432/tt_test
# Prisma shadow DB for `migrate:check`; wiped on every run, never point it at tt or tt_test.
DATABASE_URL_SHADOW=postgresql://app_system:app@localhost:5432/tt_shadow

REDIS_URL=redis://localhost:6379

NODE_ENV=development
PORT=3001
WORKER_PORT=3002
WEB_ORIGIN=http://localhost:3000
API_URL=http://localhost:3001
LOG_LEVEL=debug
# Empty = tracing off.
OTEL_EXPORTER_OTLP_ENDPOINT=

SMTP_URL=smtp://localhost:1025

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=tt-dev
