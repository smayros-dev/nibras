{
  "name": "nibras",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "docker compose up -d && turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "turbo run e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @nibras/db migrate:dev",
    "db:migrate:test": "pnpm --filter @nibras/db migrate:test",
    "db:generate": "pnpm --filter @nibras/db generate",
    "db:seed": "turbo run build --filter=@nibras/db && pnpm --filter @nibras/db seed"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "prettier": "^3.9.0",
    "turbo": "^2.11.10",
    "yaml": "^2.9.1"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-ggr8-5vv4-36mx"
      ]
    }
  }
}
